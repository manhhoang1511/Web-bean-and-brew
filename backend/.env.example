# Sao chép thành file .env rồi điền giá trị
JWT_SECRET=doi-chuoi-bi-mat-nay
JWT_EXPIRE_MINUTES=1440

# AI Chatbot - điền 1 trong 2 (ưu tiên Gemini). Để trống = chế độ tư vấn offline.
# Lấy key Gemini miễn phí: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

